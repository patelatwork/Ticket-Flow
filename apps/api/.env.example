# Copy to .env for local development. Real environment variables take precedence.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# `npm run db:local` serves this without Docker; docker compose maps the same port.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticketflow
DATABASE_POOL_MAX=20
DATABASE_CONNECT_TIMEOUT_MS=5000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production. Browsers drop Secure cookies on plain http://localhost.
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# How long a seat hold lasts before the booking expires.
HOLD_TTL_SECONDS=600
