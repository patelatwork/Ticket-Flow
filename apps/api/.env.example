# Copy to .env for local development. Real environment variables take precedence.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# `npm run db:local` serves this without Docker; docker compose maps the same port.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticketflow
DATABASE_POOL_MAX=20
DATABASE_CONNECT_TIMEOUT_MS=5000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production. Browsers drop Secure cookies on plain http://localhost.
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# How long a seat hold lasts before the booking expires.
HOLD_TTL_SECONDS=600

# ---- Redis / queues ----
REDIS_URL=redis://localhost:6379
OUTBOX_POLL_INTERVAL_MS=500
WORKER_METRICS_PORT=9100

# ---- Payments: mock (default, local) or razorpay (test mode) ----
PAYMENT_PROVIDER=mock
# Where the mock gateway (running in the worker) delivers its webhooks.
API_BASE_URL=http://localhost:3000
MOCK_WEBHOOK_SECRET=mock-webhook-secret-change-me
MOCK_PAYMENT_WEBHOOK_DELAY_MS=2000
# success | failure
MOCK_PAYMENT_OUTCOME=success
# extra copies of each webhook
MOCK_PAYMENT_DUPLICATES=0
# also send a stale payment.failed after the capture
MOCK_PAYMENT_OUT_OF_ORDER=false
# never deliver (reconciliation picks it up)
MOCK_PAYMENT_DROP_WEBHOOKS=false
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
RECONCILE_PENDING_AFTER_MINUTES=10
PAYMENT_ABANDON_AFTER_MINUTES=120

# ---- Tickets / storage / email ----
TICKET_QR_SECRET=dev-only-qr-secret-change-me-0123456789abcdef
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=tickets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# smtp (Mailpit locally) | log
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
WEB_BASE_URL=http://localhost:5173

# ---- Hardening ----
RATE_LIMIT_ENABLED=true
SEAT_MAP_CACHE_TTL_SECONDS=15
# when set, /metrics requires it as a bearer token
# METRICS_TOKEN=a-long-random-token
